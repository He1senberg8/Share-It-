# Vite TURN server environment configuration template
# Copy this file to `.env` and replace these placeholder values with your TURN credentials.
# This config will enable direct cross-network peer transfers globally (e.g. from cell networks or behind firewalls).

VITE_TURN_URL=turn:your-turn-domain.com:3478
VITE_TURN_USERNAME=your-username
VITE_TURN_PASSWORD=your-password
